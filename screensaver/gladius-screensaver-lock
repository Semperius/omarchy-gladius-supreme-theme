#!/bin/bash
# omarchy:summary=Activate the Warhammer 40,000 Gladius Prime screensaver with rotating art, music, and lock on dismiss

if [[ $(omarchy-shell lock isLocked 2>/dev/null) == "true" ]]; then
  exit 0
fi

if pgrep -f '[o]rg.omarchy.screensaver' >/dev/null; then
  exit 0
fi

RUNNER="$HOME/.local/bin/gladius-screensaver-runner"
if [[ ! -x "$RUNNER" ]]; then
  exit 1
fi

ROTATION_MGR="$HOME/.local/bin/gladius-rotation-manager"
if [[ -x "$ROTATION_MGR" ]]; then
  TRACK_PATH=$("$ROTATION_MGR" --music)
else
  TRACK_PATH="/home/corezon_prime/.local/share/Steam/steamapps/common/Warhammer 40000 Gladius - Relics of War/Soundtrack/Gladius - Main Theme.mp3"
fi

# Stop any previous soundtrack audio process
pkill -f 'mpv.*Gladius.*Soundtrack' 2>/dev/null || true

# Start background audio playback with mpv (looping)
if [[ -n "$TRACK_PATH" && -f "$TRACK_PATH" ]]; then
  mpv --no-video --no-terminal --loop-file=inf --volume=100 "$TRACK_PATH" >/dev/null 2>&1 &
fi

focused=$(omarchy-hyprland-monitor-focused)
terminal=$(xdg-terminal-exec --print-id 2>/dev/null || echo "kitty")

hypr_focus_monitor() {
  hyprctl dispatch "hl.dsp.focus({ monitor = \"$1\" })" >/dev/null 2>&1 || hyprctl dispatch focusmonitor "$1" >/dev/null
}

hypr_exec() {
  local command
  printf -v command '%q ' "$@"

  hyprctl dispatch "hl.dsp.exec_cmd([[$command]])" >/dev/null 2>&1 || hyprctl dispatch exec -- bash -lc "$command" >/dev/null
}

SOCKET="$XDG_RUNTIME_DIR/hypr/$HYPRLAND_INSTANCE_SIGNATURE/.socket2.sock"

# Open Hyprland's event stream before spawning anything
exec {events}< <(socat -U - "UNIX-CONNECT:$SOCKET")

wait_for_screensaver_window() {
  local line deadline=$((SECONDS + 5))
  while ((SECONDS < deadline)) && IFS= read -r -t $((deadline - SECONDS)) -u "$events" line; do
    [[ $line == openwindow\>\>*,org.omarchy.screensaver,* ]] && return 0
  done
}

for m in $(hyprctl monitors -j | jq -r '.[] | .name'); do
  hypr_focus_monitor "$m"

  case $terminal in
  *Alacritty*)
    hypr_exec alacritty --class=org.omarchy.screensaver --config-file "${OMARCHY_PATH:-/usr/share/omarchy}/default/alacritty/screensaver.toml" -e "$RUNNER"
    ;;
  *ghostty*)
    hypr_exec ghostty --class=org.omarchy.screensaver --config-file="${OMARCHY_PATH:-/usr/share/omarchy}/default/ghostty/screensaver" --font-size=18 -e "$RUNNER"
    ;;
  *foot*)
    hypr_exec foot --app-id=org.omarchy.screensaver --config="${OMARCHY_PATH:-/usr/share/omarchy}/default/foot/screensaver.ini" -e "$RUNNER"
    ;;
  *)
    hypr_exec kitty --class=org.omarchy.screensaver --override font_size=18 --override window_padding_width=0 -e "$RUNNER"
    ;;
  esac

  wait_for_screensaver_window
done

hypr_focus_monitor "$focused"
